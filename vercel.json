{
  "version": 2,
  "name": "gmrit-academic-calculator",
  "builds": [
    {
      "src": "api/count.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/visitors.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/reviews.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/installs.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/subscribe.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/send-notification.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/vapid-public-key.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/count",
      "dest": "/api/count.js"
    },
    {
      "src": "/api/visitors",
      "dest": "/api/visitors.js"
    },
    {
      "src": "/api/reviews",
      "dest": "/api/reviews.js"
    },
    {
      "src": "/api/installs",
      "dest": "/api/installs.js"
    },
    {
      "src": "/api/subscribe",
      "dest": "/api/subscribe.js"
    },
    {
      "src": "/api/send-notification",
      "dest": "/api/send-notification.js"
    },
    {
      "src": "/api/vapid-public-key",
      "dest": "/api/vapid-public-key.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
